{
    "name": "ajay/expense-tracker",
    "description": "A PHP expense tracker learning project with PDO and PHPUnit tests",
    "license": "MIT",
    "authors": [
        {
            "name": "Ajay-Sah18",
            "email": "ajaysah1374@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/ExpenseValidator.php"
        ]
    },

    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
   "scripts": {
    "hello": "echo Hello from Composer!",
    "show-php": "php -v",
    "show-info": "php info.php",
    "post-autoload-dump": "echo Composer autoload files generated successfully!",
    "check-style": "phpcs",
    "fix-style": "phpcbf"
    },
    "require": {
        "vlucas/phpdotenv": "^5.8"
    }
}
